#include <stdio.h>
struct student
{
    int rollno;
    struct DOB
    {
        int date,month,year;
    }d;
};
int main() {
    struct student s;
    printf("enter student details:");
    scanf("%d",&s.rollno);
    printf("enter student DOB(date-month-year) :");
    scanf("%d%d%d",&s.d.date,&s.d.month,&s.d.year);
    printf("DOB(%d) is %d-%d-%d",s.rollno,s.d.date,s.d.month,s.d.year);
    return 0;
}
